# Required: get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_token_here

# Model to run, as owner/name. Check replicate.com/collections/text-to-video
# for current models and what they cost per video.
REPLICATE_MODEL=minimax/video-01

# Optional: extra model inputs as JSON (duration, aspect_ratio, etc.).
# Field names differ per model, so check the model's page on Replicate.
# REPLICATE_EXTRA_INPUT={"aspect_ratio":"16:9"}

# Spending guards (each video costs money)
MAX_GENERATIONS_PER_DAY=20
MAX_PER_IP_PER_HOUR=3
